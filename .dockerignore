# Git
.git
.gitignore

# Environment variables
.env
.env.*
# 단, 프론트 빌드타임 주입용 공개 키(지도 등)는 빌드 컨텍스트에 포함해야 한다.
# (.gitignore도 force-include) — 없으면 VITE_ 키가 undefined가 되고 rolldown이 지도 로더를 DCE로 제거함.
!frontend/.env.production

# Build outputs
dist
build
__pycache__
*.pyc
.pytest_cache
.coverage
htmlcov/

# Node modules (except package-lock.json)
node_modules
!package-lock.json

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Documentation
*.md
README.md
LICENSE

# PDF files
*.pdf

# Test files
tests/
**/tests/
test_*.py
*_test.py

# Python virtualenv
.venv
**/.venv

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Cloud Build
cloudbuild.yaml

# Frontend views (will be built separately)
frontend/src/views
